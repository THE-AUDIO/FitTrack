# ─── FitTrack Environment Variables ─────────────────────────
# Parts required are marked: [backend] / [frontend] / [both]
# ────────────────────────────────────────────────────────────

# ─── Backend (FastAPI) ──────────────────────────────────────
# Database
DATABASE_URL=postgresql://user:pass@host:5432/fittrack
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=fittrack

# JWT
JWT_SECRET=change-me-to-a-random-64-char-string-minimum
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend URL (CORS — must match deployed frontend)
FRONTEND_URL=http://localhost:3001

# Google Gemini AI (optional — primary AI for nutrition)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Groq AI (optional — fallback if Gemini quota exhausted)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Environment
ENVIRONMENT=development

# ─── Frontend (Next.js) — set in frontend/.env.local ────────
# NEXT_PUBLIC_API_URL=http://localhost:8001
# NEXT_PUBLIC_APP_URL=http://localhost:3001
