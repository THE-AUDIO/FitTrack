# Database
DATABASE_URL=postgresql://fittrack:fittrack@postgres:5432/fittrack
POSTGRES_USER=fittrack
POSTGRES_PASSWORD=fittrack
POSTGRES_DB=fittrack

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=change-me-to-a-random-64-char-string-minimum
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3001

# Google Gemini AI (nutrition suggestions — primary)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Groq (fallback if Gemini quota exhausted)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Environment
ENVIRONMENT=development
